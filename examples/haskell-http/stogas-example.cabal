cabal-version: 3.0
name: stogas-example
version: 0.1.0.0
build-type: Simple

executable stogas-example
  main-is: Main.hs
  other-modules: Transport
  default-language: Haskell2010
  ghc-options: -threaded -Wall
  build-depends: base >=4.18 && <5, aeson >=2.2 && <2.3, bytestring >=0.11 && <0.13,
                http-client >=0.7.19 && <0.8, http-types >=0.12 && <0.13,
                text >=2 && <3, vector >=0.13 && <0.14
  extra-libraries: stogas_verifier_ffi

test-suite native-ownership
  type: exitcode-stdio-1.0
  main-is: TestNative.hs
  other-modules: Transport
  default-language: Haskell2010
  ghc-options: -threaded -Wall
  build-depends: base >=4.18 && <5, aeson >=2.2 && <2.3, bytestring >=0.11 && <0.13,
                http-client >=0.7.19 && <0.8, network >=3.1 && <3.3
  extra-libraries: stogas_verifier_ffi
